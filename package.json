{
  "name": "royal-college",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db": "node node_modules/@electric-sql/pglite-socket/dist/scripts/server.js --db ./pglite-data --max-connections 10",
    "start": "node src/index.js",
    "build": "npx prisma generate && npx prisma migrate deploy",
    "dev": "nodemon src/index.js",
    "dev:full": "node node_modules/@electric-sql/pglite-socket/dist/scripts/server.js --db ./pglite-data --max-connections 10 --run \"nodemon src/index.js\" --include-database-url",
    "db:push": "node prisma/setup-db.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0"
  }
}
